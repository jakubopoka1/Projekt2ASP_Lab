@model PagedResult<Projekt2ASP_Lab.ViewModels.ProductionCompanyViewModel>

<!DOCTYPE html>
<html>
<head>
    <title>Production Companies</title>
</head>
<body>
    <h1>Production Companies</h1>

    <table>
        <thead>
            <tr>
                <th>Company Name</th>
                <th>Number of Movies</th>
                <th>Total Budget</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var company in Model.Items)
            {
                <tr>
                    <td>@company.Name</td>
                    <td>
                        <a href="/api/companies/@company.CompanyId/movies">
                            @company.MovieCount
                        </a>
                    </td>
                    <td>@company.TotalBudget.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
        <div>
            <span>Page @Model.CurrentPage of @Model.TotalPages</span>
            <nav>
                @if (Model.CurrentPage > 1)
                {
                    <a href="?page=1&pageSize=@Model.PageSize">First</a>
                    <a href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span>@i</span>
                    }
                    else
                    {
                        <a href="?page=@i&pageSize=@Model.PageSize">@i</a>
                    }
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize">Next</a>
                    <a href="?page=@Model.TotalPages&pageSize=@Model.PageSize">Last</a>
                }
            </nav>
        </div>

    </div>

</body>
</html>
